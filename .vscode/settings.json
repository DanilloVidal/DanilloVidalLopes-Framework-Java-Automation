{
    "java.compile.nullAnalysis.mode": "automatic",
    "java.configuration.updateBuildConfiguration": "automatic",
    "cucumberJavaRunner.enableCodeLens": true,
    "cucumberJavaRunner.projectName": "DanilloVidalLopes-selenium-FrameWork-Google-Edge",
    "cucumberJavaRunner.additionalGluePaths": [
        "com.automation.framework.presentation.steps"
    ],
    "cucumber.features": [
        "src/main/resources/features/**/*.feature"
    ],
    "cucumber.glue": [
        "src/main/java/**/*.java"
    ],
    "java.jdt.ls.vmargs": "-XX:+UseParallelGC -XX:GCTimeRatio=4 -XX:AdaptiveSizePolicyWeight=90 -Dsun.zip.disableMemoryMapping=true -Xmx4G -Xms100m -Xlog:disable",
    "java.debug.settings.onBuildFailureProceed": true
}
